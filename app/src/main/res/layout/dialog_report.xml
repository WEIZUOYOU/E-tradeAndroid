<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView android:text="举报理由" android:textSize="18sp" android:textStyle="bold"/>
    <EditText android:id="@+id/etReason" android:hint="请填写举报理由" android:layout_width="match_parent" android:layout_height="100dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/btnCancel" android:text="取消" android:layout_weight="1" android:layout_width="0dp"/>
        <Button android:id="@+id/btnSubmit" android:text="提交" android:layout_weight="1" android:layout_width="0dp"/>
    </LinearLayout>

</LinearLayout>