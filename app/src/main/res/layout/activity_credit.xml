<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- 顶部标题栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/background_white" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:elevation="2dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="信用档案" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- 信用分卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/background_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 信用分大数字 -->
            <TextView
                android:id="@+id/tvCreditScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信用分：--"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green"
                android:layout_gravity="center_horizontal" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="@color/primary_green_light"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- 交易次数 -->
            <TextView
                android:id="@+id/tvTradeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交易次数：--"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- 好评率 -->
            <TextView
                android:id="@+id/tvGoodRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="好评率：--"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>