<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.EtradeAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色调 - 校园青绿 -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        
        <!-- 辅助色 - 木质暖黄 -->
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        
        <!-- 状态栏和导航栏 -->
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:navigationBarColor">@color/background_white</item>
        
        <!-- 背景和表面 -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/background_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Material3 圆角配置 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Etrade.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Etrade.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Etrade.Large</item>
    </style>

    <style name="Theme.EtradeAndroid" parent="Base.Theme.EtradeAndroid" />
    
    <!-- 大圆角样式 - 卡片、按钮 -->
    <style name="ShapeAppearance.Etrade.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    
    <style name="ShapeAppearance.Etrade.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    
    <style name="ShapeAppearance.Etrade.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    
    <!-- 药丸形按钮样式 -->
    <style name="PillButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/gray_100</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
